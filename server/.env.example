# --- Core ---
NODE_ENV=development
PORT=5000
# MongoDB connection string (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/ajay-tour-travels
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ajay-tour-travels?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ajay-tour-travels
# Public URL of the frontend (used for sitemap/canonicals and emails)
SITE_URL=http://localhost:5173
# Comma-separated exact origins allowed to call the API with cookies (Optional: defaults to SITE_URL if omitted).
# Production: https only, no wildcards, e.g. https://your-site.vercel.app,https://www.yourdomain.com
CLIENT_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN=8h
# Set only when frontend and API share a parent domain, e.g. .yourdomain.com
COOKIE_DOMAIN=
# Cross-domain (vercel.app + onrender.com) needs "none"; same-site custom subdomains use "lax"
COOKIE_SAMESITE=lax

# --- Admin Credentials (auto-bootstrapped on server start or via npm run bootstrap-admin) ---
ADMIN_ID=admin
ADMIN_EMAIL=admin@ajaytourtravels.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Ajay Admin

# --- Optional email notifications (leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: Vercel Deploy Hook (rebuilds pre-rendered pages after content is published) ---
VERCEL_DEPLOY_HOOK_URL=
